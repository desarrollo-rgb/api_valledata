# Plantilla de configuracion de ValleData. Copia a .env y rellena tus valores.
#   cp .env.example .env
# El .env real NO se sube a git (esta en .gitignore).

# Token que esta API exige a quien la consume (hoy, DataGov). Genera uno con: openssl rand -hex 32
API_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio

# true = datos de ejemplo; false = llama a la API DataGov real.
USAR_DATAGOV_FALSO=true
# URL base de la API DataGov.
DATAGOV_API_BASE_URL=http://localhost:8000
# Token que DataGov exige (debe coincidir con el API_TOKEN de DataGov).
DATAGOV_API_TOKEN=cambia-esto-por-el-token-de-datagov
# Timeout (segundos) de las llamadas a DataGov.
DATAGOV_TIMEOUT_SEGUNDOS=30

# true = comentarios de ejemplo; false = se conecta a las 14 bases PostgreSQL reales.
USAR_POSTGRES_FALSO=true
# Host del servidor PostgreSQL (en real, la IP privada del Cloud SQL o el tunel local).
POSTGRES_HOST=localhost
# Puerto del servidor PostgreSQL.
POSTGRES_PORT=5432
# Usuario de BD de SOLO LECTURA.
POSTGRES_USER=cambia-esto-por-el-usuario-readonly
# Contrasena del usuario (en produccion, desde Secret Manager).
POSTGRES_PASSWORD=cambia-esto-por-la-contrasena
