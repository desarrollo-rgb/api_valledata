# Plantilla de configuracion. Copia este archivo a .env y rellena tus valores.
#   cp .env.example .env
# El .env real NO se sube a git (esta en .gitignore).

# --- Seguridad ---
# Token que debe presentar quien consume ESTA API (hoy, la API DataGov).
# Debe coincidir con el VALLEDATA_API_TOKEN configurado en DataGov.
# Genera uno largo y aleatorio, por ejemplo con:  openssl rand -hex 32
API_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio

# --- Cliente hacia la API DataGov (Flujo 1: consumir datos) ---
# true  -> datos de ejemplo, sin llamar a DataGov (desarrollo/pruebas).
# false -> llama a la API DataGov real.
USAR_DATAGOV_FALSO=true
DATAGOV_API_BASE_URL=http://localhost:8000
DATAGOV_API_TOKEN=cambia-esto-por-el-token-de-datagov
DATAGOV_TIMEOUT_SEGUNDOS=30

# --- Lectura de comentarios CKAN desde PostgreSQL (Flujo 2) ---
# true  -> comentarios de ejemplo, sin tocar Postgres (desarrollo/pruebas).
# false -> se conecta a las bases PostgreSQL reales.
# Usa un usuario de BD de SOLO LECTURA (en produccion, desde Secret Manager).
USAR_POSTGRES_FALSO=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cambia-esto-por-el-usuario-readonly
POSTGRES_PASSWORD=cambia-esto-por-la-contrasena
